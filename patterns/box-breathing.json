  "pattern": [
    {"on": true, "color": "#5b8fd6", "brightness": 10, "fade_ms": 2000},
    {"loop": [
      {"brightness": 80, "fade_ms": 3900},
      {"color": "#ffa8c8", "fade_ms": 100},
      {"wait_ms": 3900},
      {"color": "#5b8fd6", "fade_ms": 100},
      {"brightness": 10, "fade_ms": 3900},
      {"color": "#ffa8c8", "fade_ms": 100},
      {"wait_ms": 3900},
      {"color": "#5b8fd6", "fade_ms": 100}
    ], "for_ms": 300000},
    {"color": "3500K", "brightness": 50, "fade_ms": 3000}
  ]
}
